// boot.rv — 최소 부트 로직
// CPU 리셋 직후 가장 먼저 실행되는 코드.
// 이 시점엔 스택 포인터(sp)도 세팅 안 돼있고, 함수 호출 규약도 아직 못 씀.
// 지금 단계에서는 별도 초기화 없이 커널로 바로 넘어간다.

.section .text.boot // link.ld 가 이 섹션을 무조건 맨 앞에 배치함 (KEEP)
.global _start

_start:
  // TODO : 여기서 스택 포인터(sp) 초기화 예정
  // 지금은 함수 호출 없이 점프/루프만 쓰므로 스택 없이도 동작함
  la sp, __stack_top // 스택 포인터 초기화 - 반드시 함수 호출전에
  j kernel_main // 부트 완료 -> 커러 진입점으로 점프
